{
  "$schema": "https://opencode.ai/config.json",
  "model": "zed-local/gpt-5.6-sol",
  "provider": {
    "zed-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zed Local",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "dummy"
      },
      "models": {
        "gpt-5.6": {
          "name": "GPT-5.6 (Sol alias)",
          "options": {
            "reasoningEffort": "xhigh"
          },
